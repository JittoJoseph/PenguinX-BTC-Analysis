
# ── Database ──────────────────────────────────────────────────
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Strategy (TWAP Roll-Off, BTC 15-minute Up/Down) ───────────
# The market and its 60s TWAP lookback are fixed in code, not configured here.
#
# Evaluate entries between these two times before window close. The roll-off
# edge only exists inside the 60s lookback, and the last few seconds are too
# late to fill, so this brackets the useful stretch.
ENTRY_WINDOW_OPEN_SECONDS=50
ENTRY_WINDOW_CLOSE_SECONDS=10
# Only buy when the executable ask sits within this band. The cap is what keeps
# the upside worth the downside: at 0.90 a win still returns 11%.
MIN_ENTRY_PRICE=0.15
MAX_ENTRY_PRICE=0.90
# Require (model probability - ask) >= this. Taker fee plus half-spread costs
# roughly 2-3 probability points, so this needs headroom above that.
MIN_MODEL_EDGE=0.06
# Require the forecast settlement to clear the strike by this many settlement
# standard deviations. Blocks trades where the model is merely guessing.
MIN_SETTLEMENT_SIGMAS=0.35
# Trailing window (ms) for per-second volatility of the RAW Chainlink feed.
SIGMA_WINDOW_MS=180000
# Refuse to trade when the raw feed is older than this; the roll-off term is
# only meaningful with a current spot price.
MAX_RAW_STALENESS_MS=5000
# Stop trigger, as a fraction of entry price. Always active — there is no way to
# turn it off. A fraction rather than a fixed number of cents because entries run
# from 0.15 to 0.90: 25c below entry is 28% of a 0.90 position, 83% of a 0.30
# one, and unreachable below 0.25, which would leave the cheapest positions with
# no stop at all. The trigger only decides WHEN to sell; the fill is whatever the
# book holds at that moment and can be far worse.
STOP_LOSS_FRACTION=0.35
# Simulated submit→match round-trip for exits; the book moves in between.
EXECUTION_LATENCY_MS=250
SCAN_INTERVAL_MS=60000
STARTING_CAPITAL=10

# ── API Server ────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production
ADMIN_PASSWORD=change_me_to_something_secure
