
# ── Database ──────────────────────────────────────────────────
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Strategy (probable side at a discount, BTC 15-minute Up/Down) ──
# The market and its 60s TWAP lookback are fixed in code, not configured here.
#
# Scan for entries between these two times before window close.
ENTRY_WINDOW_OPEN_SECONDS=300
ENTRY_WINDOW_CLOSE_SECONDS=5
# Only buy the favoured side when its executable ask sits within this band. The
# cap is what keeps the upside worth the downside: at 0.85 a win returns 18%,
# and the stop can lose most of the stake.
MIN_ENTRY_PRICE=0.15
MAX_ENTRY_PRICE=0.85
# A side is favoured when |forecast - strike| clears a floor in basis points of
# price by time-to-close. The table is calibrated so that 1.0 is never wrong on
# real windows; at that setting the book has already repriced and nothing
# trades. 0.4 is the measured balance: ~98% side accuracy, a few trades a day,
# entries around 0.5.
DECIDED_FLOOR_MULTIPLIER=0.4
# The floor is also raised to this many model standard deviations when that is
# larger, so volatile regimes demand more margin. It never lowers the floor.
DECIDED_SD_MULTIPLE=3
# Skip a market whose CLOB has not printed a real fill this recently. Every
# past fill at a "stale" price was on a market the exchange had stopped
# matching; 120s blocks all of those and under 2% of healthy windows.
MARKET_LIVENESS_MS=120000
# Trailing window (ms) for per-second volatility of the RAW Chainlink feed.
SIGMA_WINDOW_MS=180000
# Refuse to trade when the raw feed is older than this.
MAX_RAW_STALENESS_MS=5000
# Stop trigger, as a fraction of entry price. Always active — there is no way to
# turn it off. The trigger only decides WHEN to sell; the fill is whatever the
# book holds at that moment and can be far worse.
STOP_LOSS_FRACTION=0.35
# Polymarket's taker delay on crypto markets (50ms since 2026-08-17). The book
# is re-read after the hold, for entries and exits alike.
EXECUTION_LATENCY_MS=50
SCAN_INTERVAL_MS=60000
STARTING_CAPITAL=10

# ── API Server ────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production
ADMIN_PASSWORD=change_me_to_something_secure
